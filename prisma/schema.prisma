generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Bookmark{
  id String @id @default(cuid())
  url String
  title String
  description String?
  isFavourite Boolean @default(false)
  createdAt DateTime @default(now())
  tags Tag[]
}

model Tag{
  id String @id @default(cuid())
  name String @unique
  bookmarks Bookmark[]
}
